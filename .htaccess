# ============================================
# STV 83 — Configuration racine (page d'attente)
# Le vrai site est sous /preprod/ avec son propre .htaccess
# ============================================

RewriteEngine On

# 1. Sécurité — Bloquer les fichiers cachés
RedirectMatch 404 /\.git
RedirectMatch 404 /\.env
RewriteRule "(^|/)\." - [F]

# 2. Forcer HTTPS (compatible reverse proxy OVH)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. Canonical sans www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# 4. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# 5. Cache léger pour la page d'attente
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html  "access plus 0 seconds"
  ExpiresByType image/png  "access plus 7 days"
</IfModule>

# 6. Headers sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>

AddDefaultCharset UTF-8
DirectoryIndex index.html
