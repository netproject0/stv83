# ============================================
# STV 83 — Configuration racine (page d'attente)
# Le vrai site est sous /preprod/ avec son propre .htaccess
# ============================================

Options -Indexes
ServerSignature Off

RewriteEngine On

# 1. Sécurité — Bloquer les fichiers cachés
RedirectMatch 404 /\.git
RedirectMatch 404 /\.env
RewriteRule "(^|/)\." - [F]

# 2. Forcer HTTPS (compatible reverse proxy OVH)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. Canonical sans www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# 4. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# 5. Cache léger pour la page d'attente
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html  "access plus 0 seconds"
  ExpiresByType image/png  "access plus 7 days"
</IfModule>

# 6. Headers sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-XSS-Protection "0"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header unset Server
</IfModule>

AddDefaultCharset UTF-8
DirectoryIndex index.html

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 403 /404.html

# Bloquer fichiers backup
<FilesMatch "(\.(bak|old|orig|swp|tmp|sql|env)|~)$">
  Require all denied
</FilesMatch>
